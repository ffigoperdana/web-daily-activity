{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "vitest.config.ts"],
  "exclude": [
    "src/sw/service-worker.ts",
    "src/sw/workbox.d.ts",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "tests/**"
  ],
  "references": [{ "path": "./tsconfig.sw.json" }]
}
